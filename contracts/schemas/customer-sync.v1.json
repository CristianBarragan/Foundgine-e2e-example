{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.example/schemas/customer-sync.v1.json",
  "title": "CustomerSync (workflow input of CustomerOnboardingWorkflow)",
  "type": "object",
  "required": ["schemaVersion", "tenantId", "crmCustomerId", "attempt", "correlationId", "kind", "name", "email", "status"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "tenantId": { "type": "string", "maxLength": 64 },
    "crmCustomerId": { "type": "integer", "description": "CRM-owned id. Never an ERP id." },
    "attempt": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string" },
    "kind": { "enum": ["Business", "Individual"] },
    "name": { "type": "string", "maxLength": 200 },
    "email": { "type": "string", "maxLength": 320 },
    "phone": { "type": "string", "maxLength": 50 },
    "status": { "enum": ["Active", "Inactive"] }
  }
}
