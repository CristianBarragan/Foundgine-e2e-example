{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.example/schemas/return-requested.v1.json",
  "title": "ReturnRequested (workflow input of ReturnProcessingWorkflow)",
  "type": "object",
  "required": [
    "schemaVersion",
    "tenantId",
    "returnId",
    "quoteId",
    "crmCustomerId",
    "erpCustomerId",
    "erpOrderId",
    "correlationId",
    "reason",
    "lines"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string"
    },
    "returnId": {
      "type": "integer",
      "description": "CRM return id; with tenantId it is the idempotency key (workflow id ReturnProcessing:<tenant>:<returnId>)."
    },
    "quoteId": {
      "type": "integer"
    },
    "crmCustomerId": {
      "type": "integer"
    },
    "erpCustomerId": {
      "type": "string"
    },
    "erpOrderId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
