{
  "realm": "foundgine-crm",
  "enabled": true,
  "displayName": "Foundgine CRM",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "crm-web",
      "name": "Foundgine CRM Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "__PUBLIC_BASE_URL__/*"
      ],
      "webOrigins": [
        "__PUBLIC_BASE_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant-id-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crm-api",
      "name": "Foundgine CRM API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "crm-admin"
      },
      {
        "name": "sales-manager"
      },
      {
        "name": "sales-representative"
      },
      {
        "name": "crm-readonly"
      },
      {
        "name": "orchestration-service",
        "description": "Service identity for the Temporal worker; may call /api/integration/* only"
      }
    ]
  },
  "protocolMappers": []
}