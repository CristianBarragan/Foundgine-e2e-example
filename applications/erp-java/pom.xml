<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone form of the supplied flattened dependency graph. The original sample
       inherited versions from ../../pom.xml, which was not included in the source ZIP. -->
  <groupId>io.github.cristianbarragan</groupId>
  <artifactId>foundgine-sample-supply-chain-advanced</artifactId>
  <version>2.2.3</version>
  <name>Foundgine Supply Chain Advanced</name>
  <description>Foundgine Java supply-chain bounded-context sample</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>27</maven.compiler.release>
    <foundgine.version>3.2.2</foundgine.version>
    <jackson.version>2.18.9</jackson.version>
    <postgresql.version>42.7.12</postgresql.version>
    <junit.version>5.12.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.cristianbarragan</groupId>
      <artifactId>foundgine-core</artifactId>
      <version>${foundgine.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.cristianbarragan</groupId>
      <artifactId>foundgine-runtime</artifactId>
      <version>${foundgine.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.cristianbarragan</groupId>
      <artifactId>foundgine-providers</artifactId>
      <version>${foundgine.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-Afoundgine.generated.package=com.foundgine.samples.supplychain.advanced.generated</arg>
            <arg>-Afoundgine.generated.name=GeneratedFoundgineMetadata</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.cristianbarragan</groupId>
              <artifactId>foundgine-providers</artifactId>
              <version>${foundgine.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
