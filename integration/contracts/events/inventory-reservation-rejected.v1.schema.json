{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.foundgine.example/events/inventory-reservation-rejected.v1.schema.json",
  "title": "InventoryReservationRejected v1",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "com.foundgine.erp.inventory-reservation-rejected.v1"
        },
        "payload": {
          "type": "object",
          "required": [
            "commercialOrderId",
            "reasonCode",
            "retryable",
            "idempotencyKey"
          ],
          "properties": {
            "commercialOrderId": {
              "type": "string",
              "minLength": 1
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}