{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.foundgine.example/events/commercial-order-accepted.v1.schema.json",
  "title": "CommercialOrderAccepted v1",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "com.foundgine.crm.commercial-order-accepted.v1"
        },
        "payload": {
          "type": "object",
          "required": [
            "commercialOrderId",
            "customerReference",
            "lines",
            "idempotencyKey"
          ],
          "properties": {
            "commercialOrderId": {
              "type": "string",
              "minLength": 1
            },
            "customerReference": {
              "type": "string",
              "minLength": 1
            },
            "requestedWarehouseReference": {
              "type": [
                "string",
                "null"
              ]
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "sku",
                  "quantity"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}