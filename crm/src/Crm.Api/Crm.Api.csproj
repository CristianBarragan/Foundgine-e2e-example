<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Crm.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Single Foundgine dependency. Core and Runtime arrive transitively; the EF Core provider, ORM core and both
         source generators (analyzers) are bundled inside this package. -->
    <PackageReference Include="Foundgine.Providers" Version="$(FoundgineVersion)" />
    <!-- Keycloak identity provider and Temporal workflow provider (bridge, process workflow, start/status endpoints). -->
    <PackageReference Include="Foundgine.Extensions" Version="$(FoundgineVersion)" />
    <!-- Microsoft Agent Framework adapter (sales bot of the Java BotNegotiationWorkflow). Post-3.3.5 in the Foundgine repo, so not
         on nuget.org yet: run scripts/pack-foundgine.sh once to place it in nuget-local (temporary). -->
    <PackageReference Include="Foundgine.Providers.AgentFramework" Version="$(FoundgineVersion)" />
    <!-- MCP streamable-HTTP transport for the Foundgine MCP adapter (Foundgine.Providers brings ModelContextProtocol 2.2.0 itself). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Temporalio" Version="[1.21.1,2.0.0)" /> <!-- floor = what Foundgine.Extensions needs (avoids NU1605) -->
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="[1.18.0,2.0.0)" />
    <PackageReference Include="Temporalio.Extensions.OpenTelemetry" Version="[1.7.0,2.0.0)" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="[1.9.0,2.0.0)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="[1.9.0,2.0.0)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="[1.9.0,2.0.0)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.9.0,2.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Infrastructure\" />
  </ItemGroup>
</Project>
