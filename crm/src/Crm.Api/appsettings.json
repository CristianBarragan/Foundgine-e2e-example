{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": { "DevHeaders": false },
  "Foundgine": {
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/enterprise",
      "Audience": "crm-api",
      "RequireHttpsMetadata": true,
      "TenantClaim": "tenant_id",
      "WarrantAudience": "foundgine",
      "WarrantKeyId": "crm-api-1",
      "WarrantPrivateKeyPemPath": null,
      "EphemeralWarrantKey": false,
      "WorkerRoles": [ "integration-service" ],
      "AdminAssignableRoles": [ "crm-sales", "crm-support" ],
      "RoleGrants": {
        "enterprise-admin":    [ { "Capability": "crm", "Operation": "read" }, { "Capability": "crm", "Operation": "write" }, { "Capability": "crm", "Operation": "admin" } ],
        "crm-admin":           [ { "Capability": "crm", "Operation": "read" }, { "Capability": "crm", "Operation": "write" }, { "Capability": "crm", "Operation": "admin" } ],
        "crm-sales":           [ { "Capability": "crm", "Operation": "read" }, { "Capability": "crm", "Operation": "write" } ],
        "crm-support":         [ { "Capability": "crm", "Operation": "read" } ],
        "integration-service": [ { "Capability": "crm", "Operation": "integrate" } ]
      }
    },
    "Temporal": { "WorkflowIdPrefix": "crm", "UnroutedTopicBehavior": "Ignore" }
  },
  "Database": {
    "MigrateOnStart": false
  },
  "Telemetry": {
    "Enabled": false
  },
  "Temporal": {
    "Enabled": false,
    "Address": "localhost:7233",
    "Namespace": "enterprise",
    "OrchestrationTaskQueue": "orchestration",
    "CrmTaskQueue": "crm",
    "FoundgineTaskQueue": "foundgine"
  }
}