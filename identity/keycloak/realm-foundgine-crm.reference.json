{
  "realm": "foundgine-crm",
  "enabled": true,
  "displayName": "Foundgine CRM",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "crm-web",
      "name": "Foundgine CRM Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant-id-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crm-api",
      "name": "Foundgine CRM API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "crm-admin"
      },
      {
        "name": "sales-manager"
      },
      {
        "name": "sales-representative"
      },
      {
        "name": "crm-readonly"
      },
      {
        "name": "orchestration-service",
        "description": "Service identity for the Temporal worker; may call /api/integration/* only"
      }
    ]
  },
  "users": [
    {
      "username": "sales",
      "enabled": true,
      "email": "sales@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Sales",
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "sales-representative"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-demo"
        ]
      }
    },
    {
      "username": "sales-other",
      "enabled": true,
      "email": "sales-other@example.test",
      "emailVerified": true,
      "firstName": "Other",
      "lastName": "Tenant",
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "crm-readonly"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-other"
        ]
      }
    }
  ],
  "protocolMappers": []
}
